---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import AdSlot from '../../components/ads/AdSlot.astro';
import WordCounter from '../../components/tools/WordCounter';
import { generateToolMeta } from '../../lib/seo/meta';
import { webPageSchema, faqPageSchema, breadcrumbSchema } from '../../lib/seo/schema';
import { siteUrl } from '../../lib/site';

const meta = generateToolMeta({
  id: 'word-counter',
  name: 'Word Counter',
  description: 'Count words, characters, sentences, paragraphs, and reading time in your text.',
});

const faqs = [
  {
    question: 'Does Fontoza store the text I enter?',
    answer: 'No. The word and character calculations run in your browser. Your text is not uploaded to Fontoza or included in analytics events.',
  },
  {
    question: 'How does the word counter treat spaces and line breaks?',
    answer: 'A word is a group of characters separated by whitespace. Repeated spaces, tabs, and line breaks are treated as separators rather than extra words.',
  },
  {
    question: 'How is reading time calculated?',
    answer: 'The estimate uses 200 words per minute and rounds up to the next whole minute. Actual reading time varies with complexity and the reader.',
  },
  {
    question: 'Can I use this for social media character limits?',
    answer: 'You can check total characters and characters without spaces here. Platform limits and counting rules can change, so confirm the final text in the destination app before publishing.',
  },
];

const schema = [
  webPageSchema({
    name: 'Word Counter - Fontoza',
    description: meta.description,
    url: meta.canonical,
  }),
  faqPageSchema(faqs),
  breadcrumbSchema([
    { name: 'Home', url: siteUrl('/') },
    { name: 'Tools', url: siteUrl('/tools/') },
    { name: 'Word Counter', url: meta.canonical },
  ]),
];
---

<Layout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  ogImage={meta.ogImage}
  schema={schema}
>
  <Header />
  <main id="main-content" class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }, { label: 'Word Counter' }]} />

    <h1 class="mb-2 text-3xl font-bold tracking-tight text-[var(--color-text)]">Word Counter</h1>
    <p class="mb-8 text-[var(--color-text-muted)]">
      Paste or type your text to instantly count words, characters (with and without spaces), sentences, paragraphs, and estimated reading time.
    </p>

    <WordCounter client:idle />

    <AdSlot slot="bottom" />

    <section class="mt-12 space-y-5 text-sm leading-relaxed text-[var(--color-text-muted)]">
      <h2 class="text-xl font-bold text-[var(--color-text)]">What the counter measures</h2>
      <p>The Fontoza Word Counter updates locally as you type. It reports words, all characters, characters excluding whitespace, sentences, paragraphs, and estimated reading time. Nothing you type is sent to our server or recorded as analytics content.</p>
      <div class="grid gap-4 sm:grid-cols-2">
        <article class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5">
          <h3 class="font-semibold text-[var(--color-text)]">Words and characters</h3>
          <p class="mt-2">Words are separated by spaces, tabs, or line breaks. The character total includes spaces and punctuation; “No Spaces” removes all whitespace so you can compare both counts.</p>
        </article>
        <article class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5">
          <h3 class="font-semibold text-[var(--color-text)]">Sentences and paragraphs</h3>
          <p class="mt-2">Sentence estimates use full stops, question marks, and exclamation marks. Paragraphs are groups of text separated by a blank line, so unusual formatting can affect either result.</p>
        </article>
      </div>
      <h2 class="pt-2 text-xl font-bold text-[var(--color-text)]">Useful ways to check a draft</h2>
      <ul class="list-disc space-y-2 pl-5">
        <li>Compare an essay or article draft with its requested word range.</li>
        <li>Check a caption in both characters-with-spaces and characters-without-spaces formats.</li>
        <li>Estimate reading time at 200 words per minute before publishing a guide.</li>
        <li>Spot an accidental wall of text by checking paragraph and sentence totals.</li>
      </ul>
      <p>Counts are practical estimates, not editorial or academic certification. Hyphenation, abbreviations, emoji, and punctuation conventions can be interpreted differently by other software.</p>
    </section>

    <section class="mt-12">
      <h2 class="mb-5 text-xl font-bold text-[var(--color-text)]">Frequently asked questions</h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between font-semibold text-[var(--color-text)]">
              {faq.question}
              <span class="ml-4 text-[var(--color-text-muted)] transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-[var(--color-text-muted)]">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <nav class="mt-12 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5" aria-label="Related text tools">
      <h2 class="text-lg font-bold text-[var(--color-text)]">Continue editing your text</h2>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/tools/character-counter/" class="rounded-xl border border-[var(--color-border)] px-4 py-2 text-sm font-semibold text-[var(--color-text)] hover:border-indigo-400 hover:text-[var(--color-accent)]">Character Counter</a>
        <a href="/tools/text-case-converter/" class="rounded-xl border border-[var(--color-border)] px-4 py-2 text-sm font-semibold text-[var(--color-text)] hover:border-indigo-400 hover:text-[var(--color-accent)]">Text Case Converter</a>
        <a href="/fonts/" class="rounded-xl border border-[var(--color-border)] px-4 py-2 text-sm font-semibold text-[var(--color-text)] hover:border-indigo-400 hover:text-[var(--color-accent)]">Browse Font Styles</a>
      </div>
    </nav>
  </main>
  <Footer />
</Layout>
